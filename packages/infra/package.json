{
  "name": "@jot/infra",
  "version": "0.0.0",
  "private": true,
  "description": "AWS CDK app for the job opportunity tracker",
  "type": "module",
  "scripts": {
    "build": "cdk synth --quiet",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:ci-role": "cdk deploy -c ci=true Jot-Ci",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "^2.1145.0",
    "tsx": "^4.23.15"
  }
}
